---
// src/components/GameWrapper.astro
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: string;
  width?: string;
  height?: string;
  // With an aspect ratio (like "1 / 1"), width is a maximum and the game shrinks to fit narrow screens.
  aspectRatio?: string;
  // Shown until the player clicks to load the game.
  poster?: ImageMetadata;
  posterAlt?: string;
}

const { src, width = "800px", height = "600px", aspectRatio, poster, posterAlt = "" } = Astro.props;
const size = aspectRatio
  ? `width: 100%; max-width: ${width}; aspect-ratio: ${aspectRatio};`
  : `width: ${width}; height: ${height};`;
---

<div class="game-container" style={size}>
  <iframe frameborder="0" class="game-iframe" data-src={src}></iframe>
  {poster && <Image class="game-poster" src={poster} alt={posterAlt} loading="eager" />}
  <div class="focus-overlay">Click to Play</div>
</div>

<style>
  .game-container {
    position: relative;
    margin: 2rem auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .game-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .game-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .game-container.is-loaded .game-poster {
    display: none;
  }

  .focus-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background: rgba(0, 0, 0, 0.1);
    color: #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: var(--sl-font-sans);
    font-size: 2rem;
    font-weight: 600;
    cursor: pointer;
    text-shadow: 0 0 6px black;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    z-index: 10;
  }

  .game-container.is-focused .focus-overlay {
    opacity: 0;
    visibility: hidden;
    pointer-events: none; /* Allows mouse clicks to hit the game canvas */
  }
</style>

<script>
  function setupGameContainers() {
    const containers = document.querySelectorAll('.game-container');

    containers.forEach(container => {
      const iframe = container.querySelector('.game-iframe') as HTMLIFrameElement;
      const overlay = container.querySelector('.focus-overlay') as HTMLDivElement;

      if (!iframe || !overlay) return;

      overlay.addEventListener('click', () => {
        if (!iframe.src && iframe.dataset.src) {
          iframe.src = iframe.dataset.src;
        }
        iframe.focus();
        container.classList.add('is-focused', 'is-loaded');
      });

      window.addEventListener('blur', () => {
        setTimeout(() => {
          if (document.activeElement === iframe) {
            container.classList.add('is-focused');
          }
        }, 100);
      });

      window.addEventListener('focus', () => {
        setTimeout(() => {
          if (document.activeElement !== iframe) {
            container.classList.remove('is-focused');
          }
        }, 100);
      });
    });
  }

  setupGameContainers();  
  document.addEventListener('astro:after-swap', setupGameContainers);
</script>
