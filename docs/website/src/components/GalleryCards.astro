---
// Used to show the list of game as cards in the gallery.
// Uses the page title and description, with the
// `thumbnail.png` stored next to it (gallery/<page>/thumbnail.png).
// Cards are ordered by `sidebar.order`.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const thumbnails = import.meta.glob<{ default: ImageMetadata }>("../content/docs/gallery/*/thumbnail.png", { eager: true });
const thumbnailOf = (slug: string) => thumbnails[`../content/docs/gallery/${slug}/thumbnail.png`]?.default;

const games = (await getCollection("docs", (entry) => entry.id.startsWith("gallery/")))
	.map((entry) => ({ entry, slug: entry.id.slice("gallery/".length) }))
	.filter(({ slug }) => slug !== "" && slug !== "index")
	.sort((a, b) => (a.entry.data.sidebar.order ?? Infinity) - (b.entry.data.sidebar.order ?? Infinity));
---

<div class="gallery-cards not-content">
	{
		games.map(({ entry, slug }) => {
			const thumbnail = thumbnailOf(slug);
			return (
				<a class="gallery-card" href={`/gallery/${slug}/`}>
					{thumbnail ? <Image src={thumbnail} alt="" width={480} loading="lazy" /> : <div class="no-thumbnail" />}
					<div class="gallery-card-text">
						<h2>{entry.data.title}</h2>
						<p>{entry.data.description}</p>
					</div>
				</a>
			);
		})
	}
</div>

<style>
	.gallery-cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.5rem;
		margin: 2rem 0 3rem;
	}

	.gallery-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--sl-color-bg-sidebar);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.gallery-card:hover {
		border-color: var(--sl-color-accent);
		box-shadow: 0 4px 24px color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
		transform: translateY(-2px);
	}

	.gallery-card img,
	.no-thumbnail {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		display: block;
		flex: none;
		background: var(--sl-color-gray-6);
	}

	.gallery-card-text {
		flex: 1;
		padding: 0.9rem 1rem 1.1rem;
	}

	.gallery-card h2 {
		margin: 0 0 0.35rem;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
	}

	.gallery-card p {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		line-height: 1.5;
	}
</style>
