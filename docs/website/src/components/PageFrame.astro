---
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';

const { hasSidebar } = Astro.locals.starlightRoute;

---

<div class="page sl-flex">
	<header class="header"><slot name="header" /></header>
	{
		hasSidebar && (
			<nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
				<MobileMenuToggle />
				<script>
					// Same as Starlight's PageFrame: the mobile menu is a popover (opened by the menu button
					// through popovertarget), with focus trapping while it is open.
					class StarlightSidebarPane extends HTMLElement {
						constructor() {
							super();
							const desktopMediaQuery = matchMedia('(min-width: 50em)');
							const resetPopoverAttribute = () => {
								this.popover = desktopMediaQuery.matches ? null : 'auto';
							};
							resetPopoverAttribute();
							desktopMediaQuery.addEventListener('change', () => resetPopoverAttribute());
							this.addEventListener('toggle', ({ newState }) => this.trapFocus(newState === 'open'));
						}
						trapFocus(shouldTrap: boolean) {
							document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach((el) => {
								el.toggleAttribute('inert', shouldTrap);
							});
						}
					}
					customElements.define('sl-sidebar-pane', StarlightSidebarPane);
				</script>
				<sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
					<div class="sidebar-content sl-flex">
						<slot name="sidebar" />
					</div>
				</sl-sidebar-pane>
			</nav>
		)
	}
	<div class="main-frame"><slot /></div>
	{!hasSidebar && <footer class="footer">
          <div class="footer-content">
		  <div class="copyright">
              &COPY; {new Date().getFullYear()} Vectarine
          </div>
          <div class="footer-links">
			<div>
				<h3>Links</h3>
				<a href="/guides/overview/" class="sl-link">Overview</a>
				<a href="/guides/faq/" class="sl-link">FAQ</a>
				<a href="/blog/" class="sl-link">Blog</a>
			</div>
			<div>
				<h3>Socials</h3>
				<a href="https://github.com/vanyle/vectarine" class="sl-link">GitHub</a>
				<a href="https://reddit.com/r/vectarine" class="sl-link">Reddit</a>
				<a href="https://www.youtube.com/channel/UC4mMBWiU0SerKfBM2VfBU2w" class="sl-link">Youtube</a>
				<a href="https://discord.gg/zPwg3VDydz" class="sl-link">Discord</a>
			</div>
		  </div>
		  </div>
        </footer>
	}
</div>

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			padding-inline-end: var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-nav);
		}

		.footer {
			display: flex;
			flex-direction: column;
			align-items: center;
			width: 100%;
			margin-top: auto;
			border-top: 1px solid var(--sl-color-hairline-shade);
			padding: 3rem var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-nav);
		}
		.footer-content {
			width: 100%;
			max-width: 70rem;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 2.5rem;
		}
		@media (min-width: 50rem) {
			.footer-content {
				flex-direction: row;
				justify-content: space-between;
				align-items: flex-start;
			}
		}
		.copyright {
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		@media (min-width: 50rem) {
			.copyright {
				margin-top: 0.5rem;
			}
		}
		.footer-links {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			gap: 3rem;
			justify-content: center;
		}
		.footer-links > div {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}
		.footer-links h3 {
			font-size: var(--sl-text-h5);
			font-weight: 600;
			color: var(--sl-color-white);
			margin: 0;
			margin-bottom: 0.25rem;
		}
		.footer-links a {
			color: var(--sl-color-gray-2, var(--sl-color-text));
			text-decoration: none;
			transition: color 0.15s ease-in-out;
		}
		.footer-links a:hover {
			color: var(--sl-color-text-accent);
			text-decoration: underline;
			text-underline-offset: 4px;
		}

		.tagline {
			text-align: right;
			padding-top: 8px;
		}

		:global([data-has-sidebar]) .header {
			padding-inline-end: calc(
				var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
			);
		}

		.sidebar-pane {
			/* User agents apply some opinionated styles to popovers, which we don't want. */
			border: unset;
			padding: unset;
			height: unset;
			color: unset;

			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 0;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-black);
			overflow-y: auto;
			scrollbar-gutter: stable;
		}

		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 1rem var(--sl-sidebar-pad-x) 0;
			flex-direction: column;
			gap: 1rem;
		}

		@media (min-width: 50rem) {
			.sidebar-content::after {
				content: '';
				padding-bottom: 1px;
			}
		}

		.main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
		}

		@media (min-width: 50rem) {
			:global([data-has-sidebar]) .header {
				padding-inline-end: var(--sl-nav-pad-x);
			}
			.sidebar-pane {
				/* On larger screens the sidebar is always visible instead of depending on the popover state. */
				display: block;
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline-shade);
			}
		}
	}
</style>
