const PHANTOM_RESIST: { [types.DamageType]: number } = {
	blunt = 0.5,
	slash = 0.5,
	pierce = 0.5,
	fire = 0.5,
	electric = 0.5,
	acid = 0.5,
	cold = 0.5,
	dream = 2,
}

--- Targets of the snowball gallery: no fight, only points
local function target(name: string, sprite: string, behavior: string, points: number): Species
	return {
		name = name,
		description = "A target of the snowball gallery.",
		sprite = sprite,
		radius = 0.35,
		hp = 1,
		damage = 0,
		damageType = "cold",
		speed = if behavior == "hare" then 6.5 else 3.2,
		sight = 99,
		xp = 0,
		behavior = behavior,
		prize = points,
	}
end

