--[[
Creatures of the Explorium: their stats, how they behave (see monster_ai.luau) and what they drop.

A variant reuses a creature and changes some of its fields (`variant(base, changes)`), like the green bats that spit acid.

- `sprite`: prefix of the frames in the "characters" sheet ("bat_brown" uses bat_brown_0 and bat_brown_1),
  or in the "bosses" sheet when `size` is 2 (32x32 sprites)
- `radius`: size of the body, in tiles, for collisions
- `speed`: in tiles per second. `sight`: distance at which it notices the player.
- `damage` and `damageType`: what it does on contact (or with its shots)
- `resist`: damage multipliers by damage type (0.5 = half damage, 2 = double damage)
- `behavior`: name of a behavior in monster_ai.luau. `shot`: projectile used by ranged behaviors.
- `drops`: items it may drop when killed (`chance` between 0 and 1)
- `description`: shown in the bestiary of the notebook
- `mound`: the sprite of a burrowed creature (a mound of earth, or of sand)
- `armor`: a multiplier of all the damage taken, except while the creature is "flooded" (the Sun Warden)
- `hazard`: not a creature but a danger of the level (ooze dripping from the walls, puddles of poison): it can't be
  hurt, gives no experience and is not in the bestiary
- Bosses: `stateSprites` gives the sprite of some states (in the "bosses" sheet), `victory` the text of the banner
  shown when they fall
- The frontier: `dream` creatures (phantoms) only exist for a dreaming player (see dream.luau). `prize` creatures are
  the targets of the snowball gallery (gallery.luau), worth that many points. `husk` multiplies the damage taken from
  a player who is awake (the Last Watchman: only the dreaming can hurt him).

Balance: creatures are made for the player who reaches their floor. On the frontier, the player is about level 12,
hits for 15 to 18 and blocks about 4 damage: common creatures there have 45 to 70 health and hit for 10 to 14.
]]
const loader = require("@vectarine/loader")
const types = require("../types")

export type Drop = { item: string, chance: number, count: number? }

export type Species = {
	name: string,
	description: string,
	sprite: string,
	size: number?,
	radius: number,
	hp: number,
	damage: number,
	damageType: types.DamageType,
	speed: number,
	sight: number,
	xp: number,
	behavior: string,
	flying: boolean?,
	resist: { [types.DamageType]: number }?,
	shot: string?,
	poison: number?,
	drops: { Drop }?,
	boss: boolean?,
	mound: string?,
	armor: number?,
	hazard: boolean?,
	--- Menders: how much health they give back to the creatures they mend
	heal: number?,
	stateSprites: { [string]: string }?,
	victory: string?,
	dream: boolean?,
	prize: number?,
	husk: number?,
}

const module = loader.init() or {}

local function variant(base: Species, changes: { [string]: any }): Species
	local result = table.clone(base) :: any
	for key, value in changes do
		result[key] = value
	end
	return result
end

